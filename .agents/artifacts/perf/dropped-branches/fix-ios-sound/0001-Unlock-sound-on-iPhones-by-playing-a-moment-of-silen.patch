From 7388436d1f89e6b5a5a206508970324cee2a26ee Mon Sep 17 00:00:00 2001
From: Neil Skaria <neil.skaria@gmail.com>
Date: Sun, 11 Oct 2026 17:14:53 -0500
Subject: [PATCH 1/2] Unlock sound on iPhones by playing a moment of silence in
 the tap

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/lib/boot/sound.ts | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/lib/boot/sound.ts b/src/lib/boot/sound.ts
index b36afbf..b5b1721 100644
--- a/src/lib/boot/sound.ts
+++ b/src/lib/boot/sound.ts
@@ -56,7 +56,15 @@ export async function createBootSound(chimeFile: Promise<ArrayBuffer>, muted = f
 	}
 
 	return {
-		resume: () => ctx.resume(),
+		// Called in a tap. Starting the context isn't always enough on an iPhone: playing something,
+		// even a moment of silence, in the tap itself is what unlocks sound there.
+		resume() {
+			const silence = ctx.createBufferSource();
+			silence.buffer = ctx.createBuffer(1, 1, ctx.sampleRate);
+			silence.connect(ctx.destination);
+			silence.start();
+			return ctx.resume();
+		},
 		setMuted(value: boolean) {
 			master.gain.setTargetAtTime(value ? 0 : 1, ctx.currentTime, 0.02);
 		},
-- 
