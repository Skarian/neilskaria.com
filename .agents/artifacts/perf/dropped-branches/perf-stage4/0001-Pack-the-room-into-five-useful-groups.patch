 create mode 100644 src/lib/boot/assets/room-sp.glb

diff --git a/assets/3d/pack.mjs b/assets/3d/pack.mjs
index aef8b11..b5c939e 100644
--- a/assets/3d/pack.mjs
+++ b/assets/3d/pack.mjs
@@ -4,7 +4,7 @@
 // portrait) and writes the files the site loads into src/lib/boot/assets/. Everything here was
 // checked side by side against the export: the textures and lighting are smaller, not different.
 //
-//  - bedroom.glb: colour textures to 512px WebP (the bonsai's wood 1024px), shapes re-compressed with
+//  - room-shell/sp/cube/clock/bonsai.glb: the room and four interactive groups, with colour textures to 512px WebP (the bonsai's wood 1024px), shapes re-compressed with
 //    Draco once (positions at 14 bits), the cloth and a few soft shapes simplified, texture
 //    coordinates dropped where nothing is textured. The bonsai's twigs are pinned to the trunk by
 //    bonsai-roots.json; this checks the trunk they're pinned to is still where it was.
@@ -182,11 +182,30 @@ async function packModel() {
 			decodeSpeed: 5
 		})
 	);
-	const out = path(TO, 'bedroom.glb');
-	await io.write(out, doc);
-
-	const packed = await io.read(out);
-	await packConsoleHull(packed);
+	// Split whole roots, keeping their children and the shared atlas coordinates in place.
+	const groupOf = (name) =>
+		name === 'SP' ? 'sp' : /^(Cube|Clock|Bonsai)/.exec(name)?.[1].toLowerCase() ?? 'shell';
+	const order = root.listScenes()[0].listChildren().map((node) => node.getName());
+	let packed;
+	for (const group of ['shell', 'sp', 'cube', 'clock', 'bonsai']) {
+		const part = fn.cloneDocument(doc);
+		const scene = part.getRoot().listScenes()[0];
+		for (const node of [...scene.listChildren()])
+			if (groupOf(node.getName()) !== group) {
+				const removed = [];
+				node.traverse((child) => removed.push(child));
+				for (const child of removed.reverse()) child.dispose();
+			}
+		await part.transform(fn.prune({ keepLeaves: true, keepAttributes: true }));
+		if (group === 'shell') scene.setExtras({ ...scene.getExtras(), roomOrder: order });
+		const out = path(TO, `room-${group}.glb`);
+		await io.write(out, part);
+		// Checks use the same decoded positions the browser receives.
+		const decoded = await io.read(out);
+		if (group === 'sp') await packConsoleHull(decoded);
+		if (group === 'bonsai') packed = decoded;
+		report.push(`room-${group}.glb ${kb(readFileSync(out).length)}`);
+	}
 
 	// The twigs' roots must still sit on the trunk.
 	const roots = JSON.parse(readFileSync(path(TO, 'bonsai-roots.json'), 'utf8')).roots;
@@ -211,7 +230,6 @@ async function packModel() {
 					`Update bonsai-roots.json (and bump its version) on purpose if so.`
 			);
 	}
-	report.push(`bedroom.glb ${kb(readFileSync(source).length)} -> ${kb(readFileSync(out).length)}`);
 }
 
